# Local development: copy to .env.local. Coolify: set runtime environment values.
# Generate fresh credentials; never reuse the supplied legacy secret file.
SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://tfw_app:replace-with-new-app-password@localhost:5432/thefastestweb
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
# Enable only behind your controlled reverse proxy. Required in production.
AUTH_TRUST_HOST=true

# PSI keys are optional; keyless calls depend on Google's public quota.
# Cron and avatar integrations remain unavailable without their credentials.
GOOGLE_PSI_API_KEY=
GOOGLE_PSI_API_KEY_BACKUP=
CRON_SECRET=
UNAVATAR_API_KEY=

# Docker supplies this automatically. Local development needs an installed browser.
CHROMIUM_EXECUTABLE_PATH=
LOG_LEVEL=info
DB_MAX_CONNECTIONS=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_IDLE_TIMEOUT_SECONDS=20
DB_STATEMENT_TIMEOUT_MS=10000

# Legacy email is disabled while awaiting the Microsoft Graph migration.
# The old Polar endpoints are retired; no POLAR_* credentials are used.
ENABLE_LEGACY_RESEND=false
RESEND_API_KEY=

# Compose database bootstrap only. Never use this administrator as the app role.
POSTGRES_ADMIN_PASSWORD=

# Migration CLI only: owner/admin URL. Never supply this to the web runtime.
MIGRATION_DATABASE_URL=
