# Local development: copy to .env.local. Coolify: set runtime environment values.
# Generate fresh credentials; never reuse the supplied legacy secret file.
SITE_URL=http://localhost:3000
SITE_NAME=TheFastestWeb
DEPLOYMENT_MODE=production
# Coolify raw Compose only: hostname without scheme or port. The wrapper derives
# TFW_COOLIFY_NETWORK from the application resource UUID argument.
TFW_PUBLIC_HOST=
SITE_EMAIL=cengiz@domain.com
# Optional cross-promotion link; independent accounts and products.
INDIETOOLS_URL=https://www.indietools.app
DATABASE_URL=postgresql://tfw_app:replace-with-new-app-password@localhost:5432/thefastestweb
# Redis production URL requires authentication. Use the Compose service hostname
# redis in containers; keep the same generated password in REDIS_PASSWORD below.
REDIS_URL=redis://:replace-with-generated-64-character-hex-password@localhost:6379/0
QUEUE_PREFIX=tfw
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
# Enable only behind your controlled reverse proxy. Required in production.
AUTH_TRUST_HOST=true

# PSI keys are optional; keyless calls depend on Google's public quota.
# Avatar integrations remain unavailable without their credentials. HTTP cron is retired.
GOOGLE_PSI_API_KEY=
GOOGLE_PSI_API_KEY_BACKUP=
UNAVATAR_API_KEY=

# Docker supplies this automatically. Local development needs an installed browser.
CHROMIUM_EXECUTABLE_PATH=
LOG_LEVEL=info
DB_MAX_CONNECTIONS=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_IDLE_TIMEOUT_SECONDS=20
DB_STATEMENT_TIMEOUT_MS=10000

# Global request budgets cover PageSpeed retries and all web/worker instances.
WORKER_CONCURRENCY=2
PSI_REQUESTS_PER_MINUTE=10
PSI_REQUESTS_PER_DAY=1000
JOB_MAX_ATTEMPTS=3
WORKER_HEALTH_PORT=3001
SCHEDULER_HEALTH_PORT=3002
# Enable daily generation after retiring old external cron jobs. Compose starts the scheduler by default.
# false keeps dispatch/retries running but disables recurring job generation (demo default).
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60

# Redis container only: generate 32 random bytes as 64 hex characters.
REDIS_PASSWORD=
REDIS_MAXMEMORY_MB=256

# Enable each integration only after configuring this project's own account.
# Products and prices are approved server-side in the product catalog.
PAYMENTS_ENABLED=false
DODO_ENVIRONMENT=test_mode
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# Microsoft Graph application credentials. Scope Mail.Send to the chosen mailbox.
EMAIL_ENABLED=false
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER=
EMAIL_UNSUBSCRIBE_SECRET=

# Separate private and public R2 buckets. Private objects never get public URLs.
STORAGE_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=

# Central screenshot service. Generate a distinct 32-byte hexadecimal client key.
SCREENSHOTS_ENABLED=false
SCREENSHOT_CLIENT_ID=thefastestweb
SCREENSHOT_SERVICE_URL=
SCREENSHOT_SERVICE_TOKEN=

# Browser analytics require consent. Use a dedicated TheFastestWeb DataFast website.
ANALYTICS_ENABLED=false
GA_MEASUREMENT_ID=
DATAFAST_WEBSITE_ID=
DATAFAST_DOMAIN=
# Website-scoped payment API key, server/worker only; do not also enable a Dodo-to-DataFast webhook.
DATAFAST_API_KEY=
# Separate server crawler SDK; optional dfbot_ token from the Bot traffic settings.
DATAFAST_BOT_TRACKING_ENABLED=false
DATAFAST_BOT_TOKEN=
# Enable only after the ingress exclusively accepts a trusted proxy that overwrites
# this header with ONE client IP. 'none' records crawler hints without IP verification.
DATAFAST_BOT_TRUSTED_IP_HEADER=none
SEARCH_CONSOLE_VERIFICATION=
BING_VERIFICATION=
INDEXNOW_KEY=

# Compose database bootstrap only. Never use this administrator as the app role.
POSTGRES_ADMIN_PASSWORD=

# Migration CLI only: owner/admin URL. Never supply this to the web runtime.
MIGRATION_DATABASE_URL=
