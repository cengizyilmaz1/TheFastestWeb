{
  "name": "thefastestweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "tsx scripts/db/integration.ts && vitest run --config vitest.integration.config.mts",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "audit:production": "npm audit --omit=dev",
    "test:runtime": "vitest run src/config/shutdown.test.ts",
    "build:jobs": "node scripts/build-jobs.mjs",
    "worker": "node dist/jobs/worker.cjs",
    "scheduler": "node dist/jobs/scheduler.cjs",
    "queue:admin": "node dist/jobs/queue-admin.cjs",
    "test:public": "node scripts/verify-public.mjs",
    "admin:bootstrap": "node dist/jobs/admin-bootstrap.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/typography": "0.5.20",
    "bullmq": "6.3.8",
    "dodopayments": "2.51.0",
    "dotenv": "18.0.1",
    "drizzle-orm": "0.45.2",
    "gray-matter": "4.0.3",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.5.0",
    "next": "16.3.5",
    "next-auth": "4.24.15",
    "next-mdx-remote": "6.0.0",
    "parse5": "8.0.1",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "puppeteer-core": "25.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "sharp": "0.35.4",
    "standardwebhooks": "1.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "lighthouse": "13.5.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
